generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SchedulingType {
  INDIVIDUAL
  ROUND_ROBIN
  COLLECTIVE
}

enum TeamMemberRole {
  OWNER
  MEMBER
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String               @unique
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  accounts           Account[]
  sessions           Session[]
  eventTypes         EventType[]
  bookings           Booking[]              @relation("BookingOwner")
  assignedBookings   Booking[]              @relation("BookingAssignee")
  weeklyAvailability WeeklyAvailability?
  dateOverrides      DateOverride[]
  ownedTeams         Team[]               @relation("TeamOwner")
  teamMemberships    TeamMember[]
  calendarEvents     CalendarEvent[]
  bookingParticipants BookingParticipant[]
}

model Team {
  id          String           @id @default(cuid())
  name        String
  slug        String
  ownerId     String
  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  eventTypes  EventType[]
  invitations TeamInvitation[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([ownerId, slug])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([email])
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

model EventType {
  id                  String         @id @default(cuid())
  title               String
  slug                String
  description         String?
  duration            Int
  color               String?
  location            String?
  isActive            Boolean        @default(true)
  requiresConfirmation Boolean       @default(true)
  schedulingType      SchedulingType @default(INDIVIDUAL)
  bufferBefore        Int            @default(0)
  bufferAfter         Int            @default(0)
  minimumNotice       Int            @default(0)
  maximumAdvanceDays  Int            @default(30)
  maximumBookingsPerDay Int          @default(0)
  maximumBookingsPerWeek Int         @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId              String?
  team                Team?          @relation(fields: [teamId], references: [id])
  bookings            Booking[]

  @@unique([userId, slug])
  @@index([teamId])
}

model Booking {
  id                      String              @id @default(cuid())
  userId                  String
  user                    User                @relation("BookingOwner", fields: [userId], references: [id], onDelete: Cascade)
  eventTypeId             String
  eventType               EventType           @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  guestName               String
  guestEmail              String
  guestNotes              String?
  startTime               DateTime
  endTime                 DateTime
  timezone                String
  status                  BookingStatus       @default(BOOKED)
  assignedUserId          String?
  assignedUser            User?               @relation("BookingAssignee", fields: [assignedUserId], references: [id])
  googleCalendarEventId   String?
  googleCalendarId        String?
  managementToken         String?             @unique
  managementTokenExpiresAt DateTime?
  meetingUrl              String?
  meetingProvider         String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  participants            BookingParticipant[]
  calendarEvents          CalendarEvent[]

  @@index([eventTypeId, startTime, status])
  @@index([userId, status])
  @@index([assignedUserId, status])
  @@index([startTime])
}

model BookingParticipant {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  @@unique([bookingId, userId])
  @@index([userId])
}

model CalendarEvent {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  eventId    String
  calendarId String?
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model WeeklyAvailability {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervals AvailabilityInterval[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvailabilityInterval {
  id                   String              @id @default(cuid())
  weeklyAvailabilityId String
  weeklyAvailability   WeeklyAvailability  @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)
  dayOfWeek            Int
  startTime            String
  endTime              String
  isEnabled            Boolean             @default(true)

  @@index([weeklyAvailabilityId, dayOfWeek])
}

model DateOverride {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  isAvailable Boolean  @default(true)
  startTime   String?
  endTime     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}
